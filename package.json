{
  "name": "quran-usx",
  "version": "0.1.0-beta.6",
  "qusxGeneratorVersion": "0.1.0",
  "description": "QUSX (Qur'an Unified Scripture XML) — a milestone-based XML data standard for the Qur'an, modeled on the Bible's USX/USFM standard. v0.1 research prototype, not a finished standard.",
  "type": "commonjs",
  "main": "sdk/index.mjs",
  "module": "sdk/index.mjs",
  "types": "sdk/index.d.ts",
  "bin": {
    "quran-usx": "cli/qusx.mjs"
  },
  "exports": {
    ".": {
      "types": "./sdk/index.d.ts",
      "import": "./sdk/index.mjs",
      "default": "./sdk/index.mjs"
    },
    "./node": {
      "types": "./sdk/node.d.ts",
      "import": "./sdk/node.mjs",
      "default": "./sdk/node.mjs"
    },
    "./adapters": {
      "types": "./sdk/adapters.d.ts",
      "import": "./sdk/adapters.mjs",
      "default": "./sdk/adapters.mjs"
    },
    "./providers": {
      "types": "./sdk/providers.d.ts",
      "import": "./sdk/providers.mjs",
      "default": "./sdk/providers.mjs"
    },
    "./schema": "./schema/qusx.xsd",
    "./alignment": "./data/alignments/normative-v1.json",
    "./alignment-schema": "./schema/qusx-alignment.schema.json",
    "./ayah-mapping": "./data/alignments/boundary-v1.json",
    "./ayah-mapping-schema": "./schema/qusx-ayah-mapping.schema.json",
    "./review/surah-063": "./data/review/surah-063-review-v1.json",
    "./review-schema": "./schema/qusx-surah-review.schema.json",
    "./eight-riwayah-manifest": "./data/alignments/eight-riwayah-manifest-v1.json",
    "./eight-riwayah-schema": "./schema/qusx-eight-riwayah-slots.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "cli/",
    "sdk/",
    "schema/qusx.xsd",
    "schema/qusx-alignment.schema.json",
    "schema/qusx-ayah-mapping.schema.json",
    "data/alignments/normative-v1.json",
    "data/alignments/boundary-v1.json",
    "data/review/surah-063-review-v1.json",
    "schema/qusx-surah-review.schema.json",
    "schema/qusx-eight-riwayah-slots.schema.json",
    "data/alignments/eight-riwayah-manifest-v1.json",
    "data/alignments/eight-riwayah-review-candidates-v1.json.gz",
    "data/alignments/eight-riwayah-slots-v1.json.gz",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "generate": "node src/generate.js all",
    "validate": "node src/validate.js all",
    "validate:xsd": "node scripts/run-python.js scripts/xsd_validate.py",
    "test": "node test/run_tests.js && node --test test/sdk.test.mjs test/adapters.test.mjs test/providers.test.mjs test/cli.test.mjs test/candidate-alignments.test.js test/normative-alignment.test.js test/review-bundle.test.mjs test/eight-riwayah.test.mjs",
    "review:surah": "node scripts/build_surah_review_bundle.mjs",
    "align:candidates": "node scripts/generate_candidate_alignments.js",
    "align:review-data": "node scripts/build_alignment_review_data.js",
    "align:boundaries": "node scripts/generate_boundary_mappings.js",
    "align:metrics": "node scripts/report_alignment_metrics.js",
    "checksum": "node src/checksum-verify.js",
    "checksum:full-options": "node scripts/checksum-verify-full-options.js",
    "checksum:baseline": "node scripts/checksum-baseline.js",
    "validate:schematron": "node scripts/run-python.js scripts/schematron_validate.py",
    "conformance": "node test/conformance/verify-manifest.js && node test/conformance/run-conformance.js",
    "hashes": "node scripts/hash_sources.js",
    "validate:pilot": "node scripts/run-python.js scripts/xsd_validate.py --pilot",
    "verify:regeneration": "node scripts/verify-regeneration.js",
    "audit:qurancom": "node scripts/run-python.js scripts/audit_qurancom.py madani-v1",
    "audit:alquran-cloud": "node scripts/audit_alquran_cloud.mjs",
    "audit:provider-fatiha": "node scripts/audit_provider_fatiha.mjs",
    "verify": "npm run hashes && npm run validate && npm run validate:xsd && npm run validate:pilot && npm test && npm run conformance && npm run validate:schematron && npm run checksum:baseline && npm run checksum:full-options && npm run verify:regeneration"
  },
  "keywords": [
    "quran",
    "quranic-data",
    "islam",
    "xml",
    "usx",
    "usfm",
    "mushaf",
    "arabic",
    "milestone-markup",
    "data-standard",
    "scripture",
    "qiraat",
    "riwayat"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfordev1/usxv2.git"
  },
  "homepage": "https://github.com/dfordev1/usxv2"
}
