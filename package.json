{
  "name": "qusx",
  "version": "0.1.0",
  "description": "QUSX (Qur'an Unified Scripture XML) — a milestone-based XML data standard for the Qur'an, modeled on the Bible's USX/USFM standard. v0.1 research prototype, not a finished standard.",
  "main": "src/generate.js",
  "scripts": {
    "generate": "node src/generate.js all",
    "validate": "node src/validate.js all",
    "validate:xsd": "python scripts/xsd_validate.py",
    "test": "node test/run_tests.js",
    "checksum": "node src/checksum-verify.js",
    "checksum:full-options": "node scripts/checksum-verify-full-options.js",
    "checksum:baseline": "node scripts/checksum-baseline.js",
    "validate:schematron": "python scripts/schematron_validate.py",
    "conformance": "node test/conformance/verify-manifest.js && node test/conformance/run-conformance.js",
    "hashes": "node scripts/hash_sources.js",
    "validate:pilot": "python scripts/xsd_validate.py --pilot",
    "verify:regeneration": "node scripts/verify-regeneration.js",
    "audit:qurancom": "python scripts/audit_qurancom.py madani-v1",
    "verify": "npm run hashes && npm run validate && npm run validate:xsd && npm run validate:pilot && npm test && npm run conformance && npm run validate:schematron && npm run checksum:baseline && npm run checksum:full-options && npm run verify:regeneration"
  },
  "keywords": [
    "quran",
    "quranic-data",
    "islam",
    "xml",
    "usx",
    "usfm",
    "mushaf",
    "arabic",
    "milestone-markup",
    "data-standard",
    "scripture",
    "qiraat",
    "riwayat"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dfordev1/usxv2"
  },
  "homepage": "https://github.com/dfordev1/usxv2"
}
