<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">

  <!-- QUSX: milestone-based markup for the Qur'an, modeled on USX/USFM. -->

  <xs:simpleType name="sidRef">
    <xs:restriction base="xs:string">
      <xs:pattern value="[^:]+(:[^:]+)*"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Milestone pins are empty elements (self-closing), so no content model
       is needed; attributes go directly on the complexType, not wrapped in
       xs:sequence/xs:choice (xs:attribute is not a valid particle inside
       those; only elements are). All milestone attributes are declared
       `optional` here because XSD 1.0 has no way to express "sid XOR eid,
       and if sid then number/tradition are required too" as a schema
       constraint; that conditional/mutual-exclusion rule is semantic, not
       structural, and is enforced by src/validate.js instead. This mirrors
       how real-world XSDs handle co-occurrence constraints: schema for
       shape, a validator (or XSD 1.1 assertions / Schematron) for rules
       that span multiple attributes. -->

  <xs:complexType name="milestonePin">
    <xs:attribute name="number" type="xs:positiveInteger" use="optional"/>
    <xs:attribute name="sid" type="sidRef" use="optional"/>
    <xs:attribute name="eid" type="sidRef" use="optional"/>
  </xs:complexType>

  <xs:complexType name="ayahPin">
    <xs:attribute name="number" type="xs:positiveInteger" use="optional"/>
    <xs:attribute name="tradition" type="xs:string" use="optional"/>
    <xs:attribute name="sid" type="sidRef" use="optional"/>
    <xs:attribute name="eid" type="sidRef" use="optional"/>
  </xs:complexType>

  <xs:complexType name="word">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="xs:positiveInteger" use="required"/>
        <xs:attribute name="position" type="xs:positiveInteger" use="required"/>
        <xs:attribute name="root" type="xs:string" use="optional"/>
        <xs:attribute name="stem" type="xs:string" use="optional"/>
        <xs:attribute name="lemma" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="sajda">
    <xs:attribute name="number" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="type" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="required"/>
          <xs:enumeration value="optional"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="verseKey" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:element name="qusx">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="juz" type="milestonePin"/>
        <xs:element name="manzil" type="milestonePin"/>
        <xs:element name="hizb" type="milestonePin"/>
        <xs:element name="rub" type="milestonePin"/>
        <xs:element name="page" type="milestonePin"/>
        <xs:element name="line" type="milestonePin"/>
        <xs:element name="ayah" type="ayahPin"/>
        <xs:element name="word" type="word"/>
        <xs:element name="sajda" type="sajda"/>
      </xs:choice>

      <xs:attribute name="version" type="xs:string" use="required"/>
      <xs:attribute name="surah" type="xs:positiveInteger" use="required"/>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="nameArabic" type="xs:string" use="required"/>
      <xs:attribute name="ayahCount" type="xs:positiveInteger" use="required"/>
      <xs:attribute name="revelationPlace" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="makkah"/>
            <xs:enumeration value="madinah"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="bismillahPre" type="xs:boolean" use="required"/>
      <xs:attribute name="tradition" type="xs:string" use="required"/>
      <xs:attribute name="layout" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
