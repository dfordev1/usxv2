<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="https://dfordev1.github.io/usxv2/ns/v1"
           targetNamespace="https://dfordev1.github.io/usxv2/ns/v1"
           elementFormDefault="qualified">

  <!-- QUSX: milestone-based markup for the Qur'an, modeled on USX/USFM. -->

  <xs:simpleType name="sidRef">
    <xs:restriction base="xs:string">
      <xs:pattern value="[^:]+(:[^:]+)*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="surahNumber">
    <xs:restriction base="xs:positiveInteger">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="114"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- 286 is the largest known ayah count (Al-Baqarah, Hafs/Kufi). A future
       tradition with a larger single-surah count would need this raised;
       flagged rather than left unbounded so a nonsense value (e.g. ayahCount
       written as a word id by mistake) doesn't pass silently. -->
  <xs:simpleType name="ayahCountValue">
    <xs:restriction base="xs:positiveInteger">
      <xs:minInclusive value="1"/>
      <xs:maxInclusive value="286"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Closed to the traditions this project has actually sourced real
       per-surah ayah-count data for (see data/diff-report.json /
       docs/prior-art-references.md). "hafs-kufi" is the only one the
       generator currently emits; the rest are reserved for when
       word-level Qalun/Warsh/Douri/Shubah text is sourced (see README
       Known gaps). This is deliberately a closed enum, not an open
       xs:string, so a typo'd or invented tradition code fails loudly. -->
  <xs:simpleType name="traditionCode">
    <xs:restriction base="xs:string">
      <xs:enumeration value="hafs-kufi"/>
      <xs:enumeration value="qalon-kfqc"/>
      <xs:enumeration value="qalon-libya"/>
      <xs:enumeration value="warsh-kfqc"/>
      <xs:enumeration value="douri-kfqc"/>
      <xs:enumeration value="shubah-kfqc"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="verseKeyRef">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{1,3}:[0-9]{1,3}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Whether this file's copy of a juz/hizb/rub/manzil/ruku range is the
       entire range ("whole"), or a fragment of a range that spans more than
       one surah file: "start" (the range begins here, continues in a later
       file), "end" (continuation from an earlier file, ends here), or
       "middle" (neither starts nor ends here — a short surah entirely
       contained within one range, touching neither edge). Only meaningful on
       the opening (sid) pin. -->
  <xs:simpleType name="fragmentValue">
    <xs:restriction base="xs:string">
      <xs:enumeration value="whole"/>
      <xs:enumeration value="start"/>
      <xs:enumeration value="middle"/>
      <xs:enumeration value="end"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Milestone pins are empty elements (self-closing), so no content model
       is needed; attributes go directly on the complexType, not wrapped in
       xs:sequence/xs:choice (xs:attribute is not a valid particle inside
       those; only elements are). All milestone attributes are declared
       `optional` here because XSD 1.0 has no way to express "sid XOR eid,
       and if sid then number/tradition are required too" as a schema
       constraint; that conditional/mutual-exclusion rule is semantic, not
       structural, and is enforced by src/validate.js instead. This mirrors
       how real-world XSDs handle co-occurrence constraints: schema for
       shape, a validator (or XSD 1.1 assertions / Schematron) for rules
       that span multiple attributes. -->

  <xs:complexType name="milestonePin">
    <xs:attribute name="number" type="xs:positiveInteger" use="optional"/>
    <xs:attribute name="sid" type="sidRef" use="optional"/>
    <xs:attribute name="eid" type="sidRef" use="optional"/>
    <xs:attribute name="fragment" type="fragmentValue" use="optional"/>
  </xs:complexType>

  <xs:complexType name="ayahPin">
    <xs:attribute name="number" type="xs:positiveInteger" use="optional"/>
    <xs:attribute name="tradition" type="traditionCode" use="optional"/>
    <xs:attribute name="sid" type="sidRef" use="optional"/>
    <xs:attribute name="eid" type="sidRef" use="optional"/>
  </xs:complexType>

  <xs:complexType name="word">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="xs:positiveInteger" use="required"/>
        <xs:attribute name="position" type="xs:positiveInteger" use="required"/>
        <xs:attribute name="type" use="optional">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <!-- absent/default = ordinary lexical word; "number" = the
                   ayah-ending verse-number glyph, not part of the recited
                   text — see README Tag reference. -->
              <xs:enumeration value="number"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="root" type="xs:string" use="optional"/>
        <xs:attribute name="stem" type="xs:string" use="optional"/>
        <xs:attribute name="lemma" type="xs:string" use="optional"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="sajda">
    <xs:attribute name="number" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="type" use="required">
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:enumeration value="required"/>
          <xs:enumeration value="optional"/>
        </xs:restriction>
      </xs:simpleType>
    </xs:attribute>
    <xs:attribute name="verseKey" type="verseKeyRef" use="required"/>
  </xs:complexType>

  <xs:element name="qusx">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="juz" type="milestonePin"/>
        <xs:element name="manzil" type="milestonePin"/>
        <xs:element name="hizb" type="milestonePin"/>
        <xs:element name="rub" type="milestonePin"/>
        <xs:element name="ruku" type="milestonePin"/>
        <xs:element name="page" type="milestonePin"/>
        <xs:element name="line" type="milestonePin"/>
        <xs:element name="ayah" type="ayahPin"/>
        <xs:element name="word" type="word"/>
        <xs:element name="sajda" type="sajda"/>
      </xs:choice>

      <xs:attribute name="version" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]+\.[0-9]+(\.[0-9]+)?([-+][A-Za-z0-9.-]+)?"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="surah" type="surahNumber" use="required"/>
      <xs:attribute name="name" type="xs:string" use="required"/>
      <xs:attribute name="nameArabic" type="xs:string" use="required"/>
      <xs:attribute name="ayahCount" type="ayahCountValue" use="required"/>
      <xs:attribute name="revelationPlace" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="makkah"/>
            <xs:enumeration value="madinah"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="bismillahPre" type="xs:boolean" use="required"/>
      <xs:attribute name="tradition" type="traditionCode" use="required"/>
      <xs:attribute name="layout" type="xs:string" use="optional"/>
      <xs:attribute name="generatorVersion" type="xs:string" use="optional"/>
      <xs:attribute name="normalization" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

</xs:schema>
